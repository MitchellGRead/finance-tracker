# ---------------------------------------------------------------------------
# AI suggestions (TypeSafe Jev)
# Leave TYPESAFE_API_KEY blank to disable the feature entirely — imports and the
# rest of the app behave exactly as they did before it existed.
# Merchant descriptions are sent to a third-party API when this is set.
# ---------------------------------------------------------------------------
TYPESAFE_API_KEY=
TYPESAFE_MODEL=jev-latest
TYPESAFE_CONCURRENCY=8
TYPESAFE_TIMEOUT_MS=15000
TYPESAFE_MAX_RETRIES=3

# Run suggestions automatically in the background after a statement import.
SUGGEST_ON_IMPORT=true

# Suggestions below these confidences are discarded at write time, so anything
# stored is displayable and confirmable.
SUGGESTION_CATEGORY_CONFIDENCE=0.5
SUGGESTION_SPLIT_CONFIDENCE=0.6

# Example descriptions per category sent as Choice criteria. These dominate the
# token cost and are the main driver of suggestion quality.
SUGGESTION_EXEMPLARS_PER_CATEGORY=5
SUGGESTION_MAX_CRITERIA_CHARS=20000

# ---------------------------------------------------------------------------
# Server
# ---------------------------------------------------------------------------
PORT=3200
CORS_ORIGIN=http://localhost:5173
DATABASE_PATH=finance-tracker.db
